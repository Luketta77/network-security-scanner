# Rede que será analisada
TARGET_CIDR=192.168.1.0/24

# Portas TCP analisadas
SCAN_PORTS=21,22,23,80,443,445,3389,5432,5900,6379,8080

# Configuração da aplicação
SCAN_TIMEOUT=0.7
SCAN_WORKERS=50
METRICS_PORT=9108
REPORT_PATH=reports/security-report.json

# ==============================
# SonicWall
# ==============================

SONICWALL_ENABLED=false
SONICWALL_BASE_URL=https://192.168.1.1
SONICWALL_API_PATH=/api/sonicos
SONICWALL_USERNAME=readonly_user
SONICWALL_PASSWORD=change_me
SONICWALL_VERIFY_TLS=false

# ==============================
# Zabbix
# ==============================

ZABBIX_ENABLED=false
ZABBIX_API_URL=https://zabbix.example.com/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=change_me
ZABBIX_VERIFY_TLS=true
